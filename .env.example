# Inbox that receives website inquiries. These values stay on the server.
CONTACT_EMAIL=makeable.io@gmail.com

# Gmail SMTP. Use a Google app password, not your account password.
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=makeable.io@gmail.com
SMTP_PASS=
SMTP_FROM=makeable.io@gmail.com

# Production server settings (npm start).
PORT=3000
HOST=0.0.0.0
# Set this only when deploying behind a known reverse proxy.
TRUST_PROXY_HOPS=0
